<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="raiz" styleClass="tela-jogo" focusTraversable="true" prefHeight="760" prefWidth="1280" stylesheets="@../styles/menu-pixel.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="br.uefs.forkeazando.view.javafx.ControllerInterface">
    <children>
        <HBox prefHeight="760" prefWidth="1280" styleClass="tela-jogo">
            <children>
                <StackPane fx:id="painelArte" minWidth="0" prefHeight="760" prefWidth="550" styleClass="paisagem">
                    <children>
                        <ImageView fx:id="arte" fitHeight="760" fitWidth="805" preserveRatio="true" smooth="false" />
                    </children>
                </StackPane>
                <ScrollPane fx:id="rolagemMenu" fitToWidth="true" hbarPolicy="NEVER" minWidth="0" prefWidth="730" styleClass="rolagem-menu">
                    <content>
                <VBox fx:id="colunaMenu" alignment="CENTER" minWidth="0" spacing="7" styleClass="painel-menu">
                    <children>
                        <Label styleClass="marca-universidade" text="✦  UEFP  •  UNIVERSIDADE ESTADUAL DO FORK PERDIDO" />
                        <Label fx:id="tituloJogo" styleClass="titulo-jogo" text="FORKEAZANDO" />
                        <Label styleClass="subtitulo-jogo" text="Entre o que era certo e o que ainda pode ser." />
                        <Label styleClass="separador" text="◆  ESCOLHA SEU CAMINHO  ◆" />
                        <VBox fx:id="listaBotoes" alignment="CENTER" spacing="5" styleClass="lista-botoes">
                            <children>
                                <Button onAction="#aoClicar" styleClass="botao-menu" text="Nova Partida" userData="novaPartida" />
                                <Button onAction="#aoClicar" styleClass="botao-menu" text="Continuar" userData="continuar" />
                                <Button onAction="#aoClicar" styleClass="botao-menu" text="Carregar" userData="carregar" />
                                <Button onAction="#aoClicar" styleClass="botao-menu" text="Gerenciar saves" userData="gerenciarSaves" />
                                <Button onAction="#aoClicar" styleClass="botao-menu" text="Instruções" userData="instrucoes" />
                                <Button onAction="#aoClicar" styleClass="botao-menu" text="Configurações" userData="estilo" />
                                <Button onAction="#aoClicar" styleClass="botao-menu" text="Créditos" userData="creditos" />
                                <Button onAction="#aoClicar" styleClass="botao-menu" text="Meu progresso" userData="progresso" />
                                <Button onAction="#aoClicar" styleClass="botao-menu" text="Sair" userData="sair" />
                            </children>
                        </VBox>
                        <Label fx:id="status" styleClass="mensagem-status" text="✦ SUA HISTÓRIA COMEÇA AQUI" wrapText="true" />
                        <Label fx:id="dicaTeclado" styleClass="dica-teclado" text="↑ ↓ NAVEGAR  •  ENTER SELECIONAR  •  ESC VOLTAR" />                    </children>
                </VBox>
                    </content>
                </ScrollPane>
            </children>
        </HBox>

        <StackPane fx:id="telaSecundaria" managed="false" styleClass="sombra-modal" visible="false" />

        <StackPane fx:id="modal" managed="false" styleClass="sombra-modal" visible="false">
            <children>
                <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="640" spacing="20" styleClass="janela-modal">
                    <children>
                        <Label fx:id="tituloModal" styleClass="titulo-modal" text="TÍTULO" wrapText="true" />
                        <ScrollPane fx:id="rolagemModal" fitToWidth="true" hbarPolicy="NEVER" maxHeight="390" styleClass="rolagem-pixel">
                            <content>
                                <Label fx:id="textoModal" styleClass="texto-modal" text="Conteúdo" wrapText="true" />
                            </content>
                        </ScrollPane>
                        <Button fx:id="botaoFechar" onAction="#fecharModal" styleClass="botao-voltar" text="ENTENDI  ·  FECHAR" />
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</StackPane>
